# Plantilla de variables de entorno del frontend.
# Copiar a .env y rellenar. El .env real nunca se sube a git.

# Todo lo que lleva el prefijo VITE_ queda embebido en el bundle y es público:
# aquí no van secretos, ni claves de API, ni credenciales.

# URL base de la API, con el /api incluido. OBLIGATORIA: sin ella la app no arranca.
# Local: http://localhost:4000/api
# Producción: https://URL-DEL-BACKEND/api
VITE_API_URL=http://localhost:4000/api
